+            simplify=0.95,          # Ratio of triangles to remove in the simplification process
+            texture_size=1024,      # Size of the texture used for the GLB
+        )
+        glb.export(glb_path)
+    
+    print(f"Finished processing {args.input_image}")
+    
+def main():
+    parser = argparse.ArgumentParser(description='TRELLIS Image to 3D Pipeline')
+    parser.add_argument('--input_image', help='输入图像路径')
+    parser.add_argument('--save_base', help='输出目录路径', default="./output")
+    parser.add_argument('--save_name', help='保存文件名（不包含扩展名）', default=None)
+    parser.add_argument('--skip_glb', action='store_true', help='跳过GLB文件生成')
+    parser.add_argument('--skip_nerf', action='store_true', help='跳过RF文件生成')
+    parser.add_argument('--skip_video', action='store_true', help='跳过视频渲染')
+    parser.add_argument('--config', help='配置文件路径，每行一个参数设置')
+    
+    args = parser.parse_args()
+    
+    if args.config:
+        # 如果指定了配置文件，则读取配置文件中的参数列表
+        with open(args.config, 'r') as f:
+            config_lines = [line.strip() for line in f.readlines() if line.strip() and not line.strip().startswith('#')]
+        
+        print(f"从配置文件 {args.config} 中读取了 {len(config_lines)} 条任务")
+        
+        for i, cmd_str in enumerate(config_lines):
+            print(f"\n处理任务 [{i+1}/{len(config_lines)}]: {cmd_str}")
+            # 使用shlex.split正确处理引号内的空格
+            cmd_args_list = shlex.split(cmd_str)
+            # 解析每一条命令行参数
+            cmd_args = parser.parse_args(cmd_args_list)
+            # 执行处理
+            process_single_image(cmd_args)
+    else:
+        # 如果没有指定配置文件，则使用命令行参数
+        if not args.input_image:
+            parser.error("当不使用配置文件时，必须指定 --input_image 参数")
+        process_single_image(args)
+
+if __name__ == "__main__":
+    main()
