+# 创建一个左右并排的图像匹配可视化结果，中间无间隙
+def make_matching_figure_no_gap(data, b_id=0):
+
+    # 提取图像数据并转换为OpenCV格式（BGR）
+    color0 = (data['color0'][b_id].permute(1, 2, 0).cpu().detach().numpy() * 255).round().astype(np.uint8)
+    color1 = (data['color1'][b_id].permute(1, 2, 0).cpu().detach().numpy() * 255).round().astype(np.uint8)
+    
+    # 确保图像是BGR格式（OpenCV默认格式）
+    if color0.shape[2] == 3: color0 = cv2.cvtColor(color0, cv2.COLOR_RGB2BGR)
+    if color1.shape[2] == 3: color1 = cv2.cvtColor(color1, cv2.COLOR_RGB2BGR)
+    
+    # 获取图像尺寸
+    h0, w0 = color0.shape[:2]
+    h1, w1 = color1.shape[:2]
+    
+    # 确保两张图像高度一致（必要时进行缩放）
+    if h0 != h1:
+        h = max(h0, h1)
+        color0 = cv2.resize(color0, (w0, h))
+        color1 = cv2.resize(color1, (w1, h))
+        h0 = h1 = h
+    
+    # 创建画布，宽度为两张图之和，高度为图高
+    H, W = h0, w0 + w1
+    out = np.zeros((H, W, 3), dtype=np.uint8)
+    
+    # 将两张图像放置在画布上（无间隙）
+    out[:, :w0] = color0
+    out[:, w0:] = color1
+    
+    # 提取匹配点
+    kpts0 = data['mkpts0_f'].cpu().detach().numpy()
+    kpts1 = data['mkpts1_f'].cpu().detach().numpy()
+    inliers = data['inliers']
+    
+    # 绘制匹配连接线和标记点
+    for (x0, y0), (x1, y1) in zip(kpts0[inliers], kpts1[inliers]):
+        pt0 = (int(x0), int(y0))
+        pt1 = (int(x1) + w0, int(y1))
+        cv2.line(out, pt0, pt1, color=(0, 255, 0), thickness=1, lineType=cv2.LINE_AA)
+        cv2.circle(out, pt0, 3, (0, 255, 0), -1, lineType=cv2.LINE_AA)
+        cv2.circle(out, pt1, 3, (0, 255, 0), -1, lineType=cv2.LINE_AA)
+    return out
 
