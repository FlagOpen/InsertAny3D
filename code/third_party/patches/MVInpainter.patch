+    def realworld_reset_dataset(self, rank=0, **kwargs):
+        image_list = []
+        mask_list = []
+        inpainted_list = []
+        fname_list = []
+
+        class_names = list(self.global_data_list.keys())
+        
+        for class_name in tqdm(class_names, desc=f"loading realset...", disable=rank != 0):
+            image_indices = self.global_data_list[f"{class_name}"]["images"].copy()
+            mask_indices = self.global_data_list[f"{class_name}"]["masks"].copy()
+
+            if len(mask_indices) == len(image_indices) + 1:
+                mask_indices = mask_indices[1:]
+                
+            # 确保图像和掩码数量一致
+            assert len(mask_indices) == len(image_indices)
+            
+            # 如果图像数量太少，可以通过重复来达到所需数量
+            if len(image_indices) < self.n_frames_per_sequence:
+                repeat_times = math.ceil(self.n_frames_per_sequence / len(image_indices))
+                image_indices = image_indices * repeat_times
+                mask_indices = mask_indices * repeat_times
+                image_indices = image_indices[:self.n_frames_per_sequence]
+                mask_indices = mask_indices[:self.n_frames_per_sequence]
+            else:
+                # 对于数量足够的图像，可以采用分批处理的方式
+                # 计算批次数
+                batch_size = self.n_frames_per_sequence
+                num_batches = (len(image_indices) + batch_size - 1) // batch_size
+                
+                batched_images = []
+                batched_masks = []
+                
+                # 分批处理
+                for i in range(num_batches):
+                    start_idx = i * batch_size
+                    end_idx = min((i + 1) * batch_size, len(image_indices))
+                    
+                    if kwargs.get("sort_frames", True):
+                        batch_images = sorted(image_indices[start_idx:end_idx], key=lambda x: x.split("/")[-1])
+                        batch_masks = sorted(mask_indices[start_idx:end_idx], key=lambda x: x.split("/")[-1])
+                    else:
+                        batch_images = image_indices[start_idx:end_idx]
+                        batch_masks = mask_indices[start_idx:end_idx]
+                    
+                    # 如果最后一批数据不足batch_size，可以通过重复来补齐
+                    if len(batch_images) < batch_size and kwargs.get("pad_last_batch", True):
+                        repeat_times = math.ceil(batch_size / len(batch_images))
+                        batch_images = (batch_images * repeat_times)[:batch_size]
+                        batch_masks = (batch_masks * repeat_times)[:batch_size]
+                    
+                    batched_images.append(batch_images)
+                    batched_masks.append(batch_masks)
+                
+                # 处理每个批次
+                for batch_idx in range(len(batched_images)):
+                    batch_images = batched_images[batch_idx]
+                    batch_masks = batched_masks[batch_idx]
+                    
+                    for inpainted in self.global_data_list[f"{class_name}"]["inpainted"]:
+                        image_list.extend(batch_images)
+                        mask_list.extend(batch_masks)
+                        inpainted_list.extend([inpainted] * len(batch_images))
+                    
+                    if len(self.global_data_list[f"{class_name}"]["inpainted"]) == 0:
+                        image_list.extend(batch_images)
+                        mask_list.extend(batch_masks)
+                        inpainted_list.extend([None] * len(batch_images))
+                
+                # 跳过下面的处理，继续下一个类别
+                continue
+            
+            # 这部分代码只会处理图像数量较少需要重复的情况
+            if kwargs.get("sort_frames", True):
+                image_indices.sort(key=lambda x: x.split("/")[-1])
+                mask_indices.sort(key=lambda x: x.split("/")[-1])
+            
+            for inpainted in self.global_data_list[f"{class_name}"]["inpainted"]:
+                image_list.extend(image_indices)
+                mask_list.extend(mask_indices)
+                inpainted_list.extend([inpainted] * len(image_indices))
+            
+            if len(self.global_data_list[f"{class_name}"]["inpainted"]) == 0:
+                image_list.extend(image_indices)
+                mask_list.extend(mask_indices)
+                inpainted_list.extend([None] * len(image_indices))
+
+        return image_list, mask_list, inpainted_list, fname_list
