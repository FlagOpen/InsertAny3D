+def my_sort(fs: str, first_num = None, first_id = None):
+    if len(fs) == 0: return fs
+    def transfer(fstr:str):
+        fstr = fstr.split("/")[-1].split(".")[0]
+        return fstr[:2],fstr[2:]
+    fs = [(fss,)+transfer(fss) for fss in fs]
+    fs.sort(key=lambda x: (x[2],x[1]))
+    fs = [f[0] for f in fs]
+    if first_id is not None:
+        for _,f in enumerate(fs): 
+            if first_id in f:
+                first_num = _
+                break
+    if first_num is not None: 
+        fs = [fs[first_num:],fs[:first_num+1][::-1]]
+        print(f"Start from: {fs[0]}")
+    return fs
+
+use_my_sort = True
+first_id=None
 
